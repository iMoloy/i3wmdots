#!/bin/sh
# =============================================================
# Date:    03.02.2025 20:31:58
#
# Dependencies:
#   → i3, polybar, eww
#
# Licensed under GPL-3.0 license
# =============================================================

# Configuration
read -r current_rice <"$HOME"/.config/i3/.rice
THEME_CONFIG="$HOME/.config/i3/rices/$current_rice/theme-config.bash"
eww_bar_path="$HOME/.config/i3/rices/$current_rice/bar"

# Get padding value from theme-config.bash
get_paddings() {
    awk -F'"' '
        /^TOP_PADDING/    { top = $2 }
        /^BOTTOM_PADDING/ { bottom = $2 }
        /^LEFT_PADDING/   { left = $2 }
        /^RIGHT_PADDING/  { right = $2 }
        END { print top, bottom, left, right }
    ' "$THEME_CONFIG"
}

set_padding() {
    i3-msg config top_padding "$1"
    i3-msg config bottom_padding "$2"
    i3-msg config left_padding "$3"
    i3-msg config right_padding "$4"
}

is_eww_theme() {
    [ "$current_rice" = "eclipse" ] || [ "$current_rice" = "glass" ] || [ "$current_rice" = "pastel" ] || [ -d "$eww_bar_path" ]
}

toggle_bar() {
    local action m

    action="$1"

    if is_eww_theme; then
        if [ "$action" = "hide" ]; then
            eww -c "$eww_bar_path" close-all
        else
            for m in $(i3-msg query -M --names); do
                eww -c "$eww_bar_path" open bar --id "$m" --arg monitor="$m"
            done
        fi
    else
        polybar-msg cmd "$action"
    fi
}

toggle_bars() {
    if [ "$1" = "hide" ]; then
        set_padding 2 2 2 2
        toggle_bar hide
    else
        set_padding $(get_paddings)
        toggle_bar show
    fi
}

case "$1" in
    -h|--hide)   toggle_bars hide ;;
    -u|--unhide) toggle_bars unhide ;;
    *)	echo "Uso: $0 [-h|--hide] [-u|--unhide]" ;;
esac
