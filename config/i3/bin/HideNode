#!/bin/sh
# =============================================================
# Date:   12.11.2025
#
# Original Idea:    https://github.com/ArnaudLelievre48/Minimizing-I3
# Ported to i3wm scratchpad
#
# Script Name: HideNode
# Description: Hides windows to scratchpad and displays a menu to restore them.
#
# Licensed under GPL-3.0 license
# =============================================================

THUMB_DIR="/tmp/Minimize_thumbs"
THEME="$HOME/.config/i3/config_dir/rofi-themes/Hide.rasi"
mkdir -p "$THUMB_DIR"

hide() {
    wid=$(xdotool getactivewindow)
    [ -z "$wid" ] && exit 1

    # take a thumbnail
    maim -i "$wid" "$THUMB_DIR/$wid.webp"
    sleep 0.05
    
    # move to scratchpad
    i3-msg "[id=\"$wid\"] move scratchpad"
}

restore() {
    wid=$1
    [ -z "$wid" ] && exit 1

    rm -f "$THUMB_DIR/$wid.webp"
    
    # show from scratchpad and disable floating to tile it
    i3-msg "[id=\"$wid\"] scratchpad show; [id=\"$wid\"] floating disable"
}

menu() {
    entries=""
    wids=""
    k=0

    # Only show windows that are currently in the scratchpad and have thumbnails
    for A in "$THUMB_DIR"/*; do
        [ -f "$A" ] || continue
        wid=$(basename "$A" .webp)
        window_name=$(xprop -id "$wid" WM_NAME 2>/dev/null | cut -d '"' -f2)
        [ -z "$window_name" ] && window_name="$wid"

        entries="${entries}${k} ~ ${window_name}\000icon\037${A}\n"
        wids="${wids}${wid}|"
        k=$((k + 1))
    done

    window=$(printf "%b" "$entries" | rofi -dmenu -show-icons -theme "$THEME")
    [ -z "$window" ] && exit 0

    index=$(printf "%s" "$window" | cut -d ' ' -f1)
    index=$((index + 1))

    wid=$(printf "%s" "$wids" | cut -d '|' -f"$index")
    [ -n "$wid" ] && restore "$wid"
}


case "$1" in
    --hide) hide "$2" ;;
    --menu) menu ;;
    *)  echo "Usage: $0 --hide | --menu"; exit 1 ;;
esac
