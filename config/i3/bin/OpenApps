#!/bin/sh
# =============================================================
# Script to control prefered apps to launch for all themes
# Date:    24.04.2025
# Licensed under GPL-3.0 license
# =============================================================

WIDGET_DIR="$HOME/.config/i3/eww"

case "$1" in
	--menu)
		RofiLauncher --launcher
		;;
	--rice)
		RiceSelector
		;;
	--terminal)
		Term --terminal
		;;
	--floating)
		Term --floating
		;;
	--checkupdates)
		Term --checkupdates
		;;
	--netmanager)
		NetManagerDM
		;;
	--pass)
		RofiPass
		;;
	--bluetooth)
		rofi-bluetooth
		;;
	--clipboard)
		clipcat-menu
		;;
	--screenshot)
		ScreenShoTer
		;;
	--powermenu)
		PowerMenu
		;;
	--android)
		AndroidMount
		;;
	--keyboard)
		KeyBoardL
		;;
	--yazi)
		Term --yazi
		;;
	--nvim)
		Term --nvim
		;;
	--music)
		Term --music
		;;
	--fetch)
		Term --fetch
		;;
	--scratch)
		i3-ScratchPad
		;;
		# Apps
    --filemanager)
        ${FILEMANAGER:-thunar}
        ;;
    --browser)
        ${BROWSER:-firefox}
        ;;
    --editor)
        ${EDITOR:-geany}
		;;
	--telegram)
		telegram-desktop
		;;
	--whats)
		firefox -new-tab https://web.whatsapp.com/
		;;
	--soundcontrol)
		pavucontrol
		;;
		# Eww Widgets
	--KeyHelp)
		eww -c "$WIDGET_DIR" open --toggle csheet
		;;
	--usercard)
		eww -c "$WIDGET_DIR" open --toggle launchermenu
		;;
	*)
		echo "Invalid Option"
		;;
esac
