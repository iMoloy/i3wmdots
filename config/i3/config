# i3 config file
# Ported from i3dots

set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:monospace 8

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Define Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

# kill focused window
bindsym $mod+q kill
bindsym $mod+Shift+q kill

# start a terminal
bindsym $mod+Return exec --no-startup-id ~/.config/i3/bin/OpenApps --terminal
bindsym $mod+Shift+Return exec --no-startup-id ~/.config/i3/bin/OpenApps --floating

# App launcher
bindsym $mod+a exec --no-startup-id ~/.config/i3/bin/OpenApps --menu

# Theme Selector
bindsym $mod+x exec --no-startup-id ~/.config/i3/bin/RiceSelector

# File manager
bindsym $mod+e exec --no-startup-id ~/.config/i3/bin/OpenApps --filemanager

# Browser
bindsym $mod+b exec --no-startup-id /usr/bin/brave-origin

# VS Code
bindsym $mod+c exec --no-startup-id code

# Antigravity
bindsym $mod+z exec --no-startup-id antigravity-ide

# Logseq
bindsym $mod+n exec --no-startup-id logseq

# Steam
bindsym $mod+g exec --no-startup-id steam

# Telegram
bindsym $mod+t exec --no-startup-id Telegram

# Discord
bindsym $mod+d exec --no-startup-id /usr/bin/discord

# Stacer
bindsym $mod+s exec --no-startup-id /usr/bin/stacer

# Disable idle
bindsym $mod+i exec --no-startup-id xset s off -dpms && notify-send "Screen 󰛨"
# Enable idle
bindsym $mod+Shift+i exec --no-startup-id xset s on +dpms && notify-send "Screen 󰹏"

# Music
bindsym $mod+m exec --no-startup-id kitty -e ncmpcpp

# Media apps
bindsym $mod+w exec --no-startup-id ~/.config/i3/bin/WallSelect

# Rice Editor App
bindsym $mod+r exec --no-startup-id ~/.config/i3/bin/RiceEditor

# Fcitx5
bindsym $mod+space exec --no-startup-id fcitx5

# ----- Rofi Applets ----- #
bindsym $mod+Mod1+t exec --no-startup-id ~/.config/i3/bin/Term --selecterm
bindsym $mod+Mod1+a exec --no-startup-id ~/.config/i3/bin/OpenApps --android
bindsym $mod+Mod1+n exec --no-startup-id ~/.config/i3/bin/OpenApps --netmanager
bindsym $mod+Mod1+b exec --no-startup-id ~/.config/i3/bin/OpenApps --bluetooth
bindsym $mod+Mod1+v exec --no-startup-id ~/.config/i3/bin/OpenApps --clipboard
bindsym $mod+Mod1+s exec --no-startup-id ~/.config/i3/bin/OpenApps --screenshot
bindsym $mod+Mod1+p exec --no-startup-id ~/.config/i3/bin/OpenApps --powermenu
bindsym $mod+Mod1+l exec --no-startup-id ~/.config/i3/bin/RofiLauncher --choose-style
bindsym $mod+Mod1+k exec --no-startup-id ~/.config/i3/bin/OpenApps --keyboard
bindsym $mod+Mod1+x exec --no-startup-id ~/.config/i3/bin/OpenApps --pass

# Scratchpad
bindsym $mod+Mod1+o scratchpad show

# ----- Environment Apps ----- #

# Reload i3
bindsym $mod+Mod1+r reload
# Restart i3 inplace
bindsym $mod+Shift+r restart
# Quit i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Volume & Brightness
bindsym XF86MonBrightnessUp exec --no-startup-id sh ~/.config/i3/bin/Brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id sh ~/.config/i3/bin/Brightness down
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/bin/Volume --inc
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/bin/Volume --dec
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/bin/Volume --toggle

# Focus nodes
bindsym $mod+Mod1+Left focus left
bindsym $mod+Mod1+Down focus down
bindsym $mod+Mod1+Up focus up
bindsym $mod+Mod1+Right focus right

# Move nodes
bindsym $mod+Mod1+Shift+Left move left
bindsym $mod+Mod1+Shift+Down move down
bindsym $mod+Mod1+Shift+Up move up
bindsym $mod+Mod1+Shift+Right move right

# Split horizontal and vertical
bindsym $mod+h split h
bindsym $mod+v split v

# Enter fullscreen mode for the focused container
bindsym Mod1+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+Shift+s layout stacking
bindsym $mod+y layout toggle split

# toggle tiling / floating
bindsym Mod1+a floating toggle

# change focus between tiling / floating windows
bindsym $mod+Tab focus mode_toggle

# Resize Mode
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+Control+r mode "default"
}
bindsym $mod+Control+r mode "resize"

# Switch workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# Window Rules (tiling logic equivalence)
for_window [class="^.*"] border pixel 2
for_window [class="floating"] floating enable

# Specific window rules
for_window [class="Pavucontrol"] floating enable
for_window [class="stacer"] floating enable
for_window [class="Lxappearance"] floating enable
for_window [class="Nitrogen"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [title="Preferences"] floating enable

# Workspace Assignments
assign [class="(?i)Code"] $ws1
assign [class="(?i)Brave-browser"] $ws2
assign [class="(?i)kitty"] $ws3
assign [class="(?i)Alacritty"] $ws3
assign [class="(?i)Thunar"] $ws4
assign [class="(?i)discord"] $ws5

# Gaps
gaps inner 5
gaps outer 5

# Autostart applications
exec_always --no-startup-id autotiling
exec --no-startup-id ~/.config/i3/bin/SetSysVars
exec --no-startup-id ~/.config/i3/bin/Theme.sh
exec --no-startup-id picom --config ~/.config/i3/config_dir/picom/picom.conf
exec --no-startup-id xsettingsd --config=~/.config/i3/config_dir/xsettingsd
exec --no-startup-id pidof -q eww || eww -c ~/.config/i3/eww daemon
exec --no-startup-id clipcatd
exec --no-startup-id lxpolkit
exec --no-startup-id dex -a -s ~/.config/autostart
