;; Catppuccin Apple Glass Vertical Dock (Right Side)

;; Workspaces
(include "./workspaces.yuck")

;; Volume & Microphone vars
(defpoll volume_value :interval "1s" "pamixer --get-volume 2>/dev/null || echo 0")
(defpoll volume_muted :interval "1s" "pamixer --get-mute 2>/dev/null || echo false")
(defpoll mic_value :interval "1s" "pamixer --default-source --get-volume 2>/dev/null || echo 0")
(defpoll mic_muted :interval "1s" "pamixer --default-source --get-mute 2>/dev/null || echo false")

;; Network
(defpoll NETSTAT :interval "15s" `scripts/Network --stat`)
(defpoll NETICON :interval "15s" `scripts/Network --icon`)
(defpoll NETSPEED :interval "1s" `scripts/Network --speed`)

;; Music vars
(defpoll SONG :interval "1s" "MediaControl --title")
(defpoll ARTIST :interval "1s" "MediaControl --artist")
(defpoll STATUS :interval "1s" "MediaControl --status")

;; Updates vars
(defpoll UPDATES :interval "15m" `cat $HOME/.cache/Updates.txt 2>/dev/null`)

;; Battery vars
(defpoll battery_status :interval "10s" "scripts/battery battery_status")
(defpoll battery_icon :run-while battery_status :interval "15s" "scripts/battery apple_icon")
(defpoll battery_percentage :run-while battery_status :interval "15s" "scripts/battery percent")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;							Widget Definitions							 ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Launcher Widget (Skull Icon) ;;
(defwidget launcher []
	(box :orientation "v"
		 :space-evenly false
		 :halign "center"
		(eventbox :cursor "pointer"
			(button :class "launcher_icon"
					:halign "center"
					:tooltip "Applications"
					:onclick "cd ; OpenApps --menu"
					:onrightclick "OpenApps --rice"
					"󰚌"))))

;; Wifi Widget ;;
(defwidget wifi []
	(box :orientation "v"
		 :space-evenly false
		 :halign "center"
		(eventbox :cursor "pointer" :onclick "OpenApps --netmanager"
			(label :class "glass_icon wifi_icon" :halign "center" :tooltip "${NETSTAT}" :text "${NETICON}"))))

;; Live Net Speed Widget (Bold & Legible) ;;
(defwidget netspeed []
	(box :orientation "v"
		 :space-evenly false
		 :class "netspeed_box"
		 :halign "center"
		 :tooltip "Network Speed: ${NETSPEED}/s"
		(label :class "netspeed_text" :text "${NETSPEED}")))

;; Battery Widget (Apple Horizontal Capsule + Percentage) ;;
(defwidget battery []
	(box :orientation "v"
		 :space-evenly false
		 :class "battery_box"
		 :halign "center"
		 :visible {battery_status ?: "false"}
		 :tooltip "Battery: ${battery_percentage}%"
		(eventbox :cursor "pointer"
			(box :orientation "v"
				 :space-evenly false
				 :halign "center"
				 :onclick "OpenApps --power"
				(image :class "apple_battery_img"
					   :path "${battery_icon}"
					   :image-width 26
					   :image-height 13)
				(label :class "battery_percent_text"
					   :text "${battery_percentage}%")))))

;; Updates Widget (Software Update Sync Icon & Count when available) ;;
(defwidget pacman []
	(box :orientation "v"
		 :space-evenly false
		 :class "pacman_box"
		 :halign "center"
		(eventbox :cursor "pointer" :onclick "OpenApps --checkupdates"
				(label :class "glass_icon pacman_icon" :halign "center" :tooltip "Updates: ${UPDATES != '' && UPDATES != '0' ? UPDATES : 'System up to date'}" :text "󰓦"))
		(label :class "updates_text"
			   :halign "center"
			   :visible {UPDATES != "" && UPDATES != "0" ? true : false}
			   :text "${UPDATES}")))

;; Sound Widget (Dual Speaker & Microphone Sliders Always Visible) ;;
(defwidget volum []
	(box :orientation "h"
		 :space-evenly false
		 :spacing 6
		 :class "sound_box"
		 :halign "center"
		;; Speaker Column
		(box :orientation "v"
			 :space-evenly false
			 :halign "center"
			 :spacing 3
			(eventbox :onscroll "scripts/Volume --scroll {}"
				(scale :class "volbar"
					   :value {volume_value ?: "0"}
					   :onchange "pamixer --set-volume {}"
					   :orientation "v"
					   :flipped true
					   :tooltip "Speaker: ${volume_value}%"
					   :max 101
					   :min 0))
			(eventbox :cursor "pointer" :onrightclick "OpenApps --soundcontrol" :onclick "scripts/Volume --toggle-muted"
					(label :class "glass_icon vol_icon" :tooltip "Speaker: ${volume_value}%" :text {volume_muted == "true" || volume_value == "0" ? "󰖁" : "󰕾"})))
		;; Microphone Column
		(box :orientation "v"
			 :space-evenly false
			 :halign "center"
			 :spacing 3
			(eventbox :onscroll "scripts/Volume --scroll-mic {}"
				(scale :class "micbar"
					   :value {mic_value ?: "0"}
					   :onchange "pamixer --default-source --set-volume {}"
					   :orientation "v"
					   :flipped true
					   :tooltip "Microphone: ${mic_value}%"
					   :max 101
					   :min 0))
			(eventbox :cursor "pointer" :onrightclick "OpenApps --soundcontrol" :onclick "pamixer --default-source -t"
					(label :class "glass_icon mic_icon" :tooltip "Microphone: ${mic_value}%" :text {mic_muted == "true" || mic_value == "0" ? "󰍭" : "󰍬"})))))

;; Date Widget (Apple Glass Style) ;;
(defwidget datebox []
	(box :orientation "v"
		 :class "date_card"
		 :halign "center"
		 :tooltip "${formattime(EWW_TIME, "%A, %B %d, %Y")}"
		(label :class "day_text" :text "${formattime(EWW_TIME, "%a")}")
		(label :class "date_text" :text "${formattime(EWW_TIME, "%d")}")
		(label :class "month_text" :text "${formattime(EWW_TIME, "%b")}")))

;; Clock Widget (12h Apple Glass format) ;;
(defwidget time []
	(box :orientation "v"
		 :class "time_card"
		 :halign "center"
		(label :class "time_hour" :text "${formattime(EWW_TIME, "%I")}")
		(label :class "time_min" :text "${formattime(EWW_TIME, "%M")}")
		(label :class "time_ampm" :text "${formattime(EWW_TIME, "%p")}")))

;; Music Control Widget (Apple Glass Style) ;;
(defwidget music []
	(box :class "music_card"
		 :orientation "v"
		 :space-evenly false
		 :halign "center"
		(eventbox :cursor "pointer"
			(button :class "music_btn"
					:onclick "MediaControl --previous"
					:tooltip "Previous Track"
					"󰒫"))
		(eventbox :cursor "pointer"
			(button :class {STATUS == "Playing" ? "music_btn_play active" : "music_btn_play"}
					:onclick "MediaControl --toggle"
					
					:tooltip {SONG != "" ? "${SONG} - ${ARTIST}" : "Music Player"}
					{STATUS == "Playing" ? "󰏤" : "󰐊"}))
		(eventbox :cursor "pointer"
			(button :class "music_btn"
					:onclick "MediaControl --next"
					:tooltip "Next Track"
					"󰒬"))))

;; Power Widget (Direct click triggers power menu) ;;
(defwidget power []
	(box :orientation "v"
		 :space-evenly false
		 :class "power_box"
		 :halign "center"
		(eventbox :cursor "pointer"
			(button :class "power_main_btn"
					:halign "center"
					:tooltip "Power Menu"
					:onclick "OpenApps --powermenu"
					"󰐥"))))

;; Systray Widget ;;
(defwidget systemtray []
	(box :orientation "v" :halign "center" :class "tray_box"
		(systray :class "tray" :orientation "v" :icon-size 15 :spacing 2)))

;; Top Section ;;
(defwidget top [monitor]
	(box :orientation "v"
		 :space-evenly false
		 :valign "start"
		 :halign "center"
		 :spacing 4
		(launcher)
		(workspaces :monitor monitor)
		(systemtray)))

;; Control Section ;;
(defwidget control []
	(box :orientation "v"
		 :space-evenly false
		 :class "control"
		 :halign "center"
		 :spacing 2
		(volum)
		(wifi)
		(netspeed)
		(battery)
		(pacman)))

;; System Resource Widget (Dual CPU & RAM Sliders matching Apple Glass) ;;
(defwidget sys_res []
	(box :orientation "v"
		 :space-evenly false
		 :class "sys_card"
		 :halign "center"
		(eventbox :cursor "pointer"
				  :onclick "alacritty -e btop &"
			(box :orientation "h"
				 :space-evenly false
				 :spacing 6
				 :halign "center"
				;; CPU Column
				(box :orientation "v"
					 :space-evenly false
					 :halign "center"
					 :spacing 3
					(scale :class "cpubar"
						   :value {round(EWW_CPU.avg, 0)}
						   :orientation "v"
						   :flipped true
						   :tooltip "CPU: ${round(EWW_CPU.avg, 0)}%"
						   :max 101
						   :min 0)
					(label :class "sys_icon cpu_icon"
						   :tooltip "CPU: ${round(EWW_CPU.avg, 0)}%"
						   :text ""))
				;; RAM Column
				(box :orientation "v"
					 :space-evenly false
					 :halign "center"
					 :spacing 3
					(scale :class "rambar"
						   :value {round(EWW_RAM.used_mem_perc, 0)}
						   :orientation "v"
						   :flipped true
						   :tooltip "RAM: ${round(EWW_RAM.used_mem_perc, 0)}% (${round(EWW_RAM.used_mem / 1073741824, 1)}GB / ${round(EWW_RAM.total_mem / 1073741824, 1)}GB)"
						   :max 101
						   :min 0)
					(label :class "sys_icon ram_icon"
						   :tooltip "RAM: ${round(EWW_RAM.used_mem_perc, 0)}%"
						   :text ""))))))

;; Middle Section (12h Clock & Date) ;;
(defwidget middle []
	(box :orientation "v"
		 :space-evenly false
		 :valign "center"
		 :vexpand true
		 :halign "center"
		 :spacing 3
		(time)
		(datebox)))

;; Bottom Section (Music, System Resources, Controls, Power) ;;
(defwidget bottom []
	(box :orientation "v"
		 :space-evenly false
		 :halign "center"
		 :spacing 3
		(music)
		(sys_res)
		(control)
		(power)))

;; End Section ;;
(defwidget end []
	(box :orientation "v"
		 :space-evenly false
		 :valign "end"
		 :halign "center"
		(bottom)))

;; Main Bar Box ;;
(defwidget bar [monitor]
	(box :class "eww_bar"
		 :orientation "v"
		 :vexpand true
		 :hexpand false
		 :space-evenly false
		(top :monitor monitor)
		(middle)
		(end)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;							Window Definition							 ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defwindow bar [monitor]
	:monitor monitor
	:geometry (geometry :x "0px"
						:y "0px"
						:anchor "top right"
						:height "100%"
						:width "48px")
	:reserve (struts :distance "48px"
					 :side "right")
	:wm-ignore false
	(bar :monitor monitor))
